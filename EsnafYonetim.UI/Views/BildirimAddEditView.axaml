<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EsnafYonetim.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="EsnafYonetim.UI.Views.BildirimAddEditView"
             x:DataType="vm:BildirimAddEditViewModel">
    <Border Padding="25" CornerRadius="10">
        <StackPanel Spacing="15">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <ToggleSwitch IsChecked="{Binding Notification.Aktif}" OnContent="Aktif" OffContent="Pasif"/>

            <TextBlock Text="Bildirim Mesajı:"/>
            <TextBox Text="{Binding Notification.Mesaj}" TextWrapping="Wrap" AcceptsReturn="True" Height="100"/>

            <TextBlock Text="Tetiklenme Zamanı:"/>
            <DatePicker SelectedDate="{Binding Notification.TetiklenmeZamani}"/>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,25,0,0">
                <Button Content="Kaydet" Command="{Binding SaveCommand}" Classes="accent"/>
                <Button Content="İptal" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
