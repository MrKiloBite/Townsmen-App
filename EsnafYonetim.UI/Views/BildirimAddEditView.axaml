<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EsnafYonetim.UI.ViewModels"
             xmlns:models="using:EsnafYonetim.Core.Models"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="EsnafYonetim.UI.Views.BildirimAddEditView"
             x:DataType="vm:BildirimAddEditViewModel">
    <Border Padding="25" CornerRadius="10">
        <StackPanel Spacing="15">
            <TextBlock Text="Bildirim Ekle / Düzenle" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <ToggleSwitch IsChecked="{Binding Bildirim.Aktif}" OnContent="Aktif" OffContent="Pasif"/>

            <TextBlock Text="Bildirim Mesajı:"/>
            <TextBox Text="{Binding Bildirim.Mesaj}"/>

            <TextBlock Text="Bildirim Tipi:" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding BildirimTipleri}" SelectedItem="{Binding Tip, Mode=TwoWay}"/>

            <!-- Zamanlanmış Bildirim Ayarları -->
            <StackPanel Spacing="10" IsVisible="{Binding IsZamanlanmisVisible}">
                <TextBlock Text="Tetiklenme Zamanı:"/>
                <DatePicker SelectedDate="{Binding Bildirim.TetiklenmeZamani}"/>
            </StackPanel>

            <!-- Stok Seviyesi Bildirim Ayarları -->
            <StackPanel Spacing="10" IsVisible="{Binding IsStokSeviyesiVisible}">
                <TextBlock Text="Koşul:"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <ComboBox Grid.Column="0" ToolTip.Tip="Hangi stok ürünü izlenecek?"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Operatorler}" SelectedItem="{Binding Bildirim.Operator}"/>
                    <NumericUpDown Grid.Column="2" Value="{Binding Bildirim.Deger}" Width="100"/>
                </Grid>
            </StackPanel>

            <TextBlock Text="Uyarı Sesi:" Margin="0,10,0,0"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Bildirim.SesDosyasiYolu}" IsReadOnly="True"/>
                <Button Content="Gözat..." Command="{Binding BrowseSoundFileCommand}" Grid.Column="1"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,25,0,0">
                <Button Content="Kaydet" Command="{Binding SaveCommand}" Classes="accent"/>
                <Button Content="İptal" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
