<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EsnafYonetim.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EsnafYonetim.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Gösterge Paneline Hoş Geldiniz!" FontSize="28" FontWeight="Bold" Margin="20"/>
    <TextBlock Text="{Binding Title}" FontSize="20" HorizontalAlignment="Center"/>
    <TextBlock Text="Bu alan, gelecekteki iş zekası ve analiz modülleri için merkez olacaktır."
               TextWrapping="Wrap"
               TextAlignment="Center"
               MaxWidth="400"
               Margin="0,20,0,0"/>
  </StackPanel>
</UserControl>
